# Responsive follower candidate, validated separately from stock defaults.
# Merge these keys into /etc/mds/local.env while grounded, then restart MDS
# and verify /api/v1/git/status smart_swarm_policy on EVERY participating node.
# Merely syncing this example does not enable it. Keep local identity/secrets.
# Speed is catch-up headroom; not a guarantee of 5 m/s leader tracking in turns.
MDS_SMART_SWARM_MAX_HORIZONTAL_SPEED_M_S=6
MDS_SMART_SWARM_MAX_VERTICAL_SPEED_M_S=1.25
MDS_SMART_SWARM_MAX_ACCELERATION_M_S2=3
MDS_SMART_SWARM_MAX_JERK_M_S3=6
